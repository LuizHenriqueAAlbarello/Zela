# Modelo das variáveis de ambiente da API. Nunca coloque usuário e senha reais em arquivos do projeto.
# Atenção: o Spring Boot NÃO lê arquivo .env sozinho. Use uma das opções:
#   - Render: Environment do serviço (DB_USER e DB_PASSWORD só no painel)
#   - Docker: copie para .env e rode  docker run --env-file .env -p 8080:8080 zela-api
#   - Local (Linux/macOS): export DB_URL=... ; no Windows PowerShell: $env:DB_URL="..."
#   - IntelliJ: Run Configuration > Environment variables
DB_URL=jdbc:oracle:thin:@oracle.fiap.com.br:1521:ORCL
DB_USER=
DB_PASSWORD=
# Origens permitidas no CORS, separadas por vírgula (ex.: http://localhost:5173,https://meu-front.vercel.app).
# Ausente ou vazia = libera todas as origens.
CORS_ORIGINS=*
